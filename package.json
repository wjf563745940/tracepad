{
  "name": "tracepad",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic UI components for visualising AI agent execution",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
