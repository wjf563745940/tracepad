  "description": "React wrapper for tracepad — thin props-and-events bridge over the headless view",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjf563745940/tracepad.git",
    "directory": "packages/react"
  },
